---
/**
 * The shell every page sits in.
 *
 * Fonts are imported as npm packages rather than linked from a CDN. This page
 * is served from 127.0.0.1 and makes no external request — the server tests
 * assert that, and a font link would be the one line that quietly broke it.
 */
import "@fontsource/inter/400.css";
import "@fontsource/geist-mono/400.css";
import "@/styles/tokens.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The Content-Security-Policy is a response header, set in
         osuforge/server/assets.py, not a meta element here. Two reasons, both
         learned from a browser console: `frame-ancestors` is ignored in a meta
         and it is the directive that stops this page being framed, and the
         inline script Astro emits for hydration has to be allowed by its hash
         — which the server computes from the page it is about to send, rather
         than the policy being loosened to 'unsafe-inline' for every script. -->
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    <slot />
  </body>
</html>
