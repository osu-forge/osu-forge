---
import Page from "@/layouts/Page.astro";
import { ReplayViewer } from "@/components/Replays";

// Substituted by the server; see `index.astro` for why the token is in the HTML
// rather than fetched.
const token = "__TOKEN__";
---

<Page title="osu-forge - replays" current="/replays/">
  <ReplayViewer token={token} client:load />
</Page>
