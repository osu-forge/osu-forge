---
import Page from "@/layouts/Page.astro";
import { CorpusView } from "@/components/CorpusView";

// Substituted by the server; see `index.astro` for why the token is in the HTML
// rather than fetched.
const token = "__TOKEN__";
---

<Page title="osu-forge - corpus" current="/corpus/">
  <CorpusView token={token} client:load />
</Page>
