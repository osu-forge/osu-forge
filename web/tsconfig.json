{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // This config covers what ships. The build-time shader sources and the
  // vendored DSL are checked by tsconfig.shaders.json instead, with settings
  // the vendored code satisfies — `exclude` alone would not do it, because
  // TypeScript follows imports regardless. The alternative was patching
  // vendored files, which makes the next copy a merge, or loosening the
  // settings for the application too.
  "exclude": ["dist", "vendor", "shaders", "scripts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // The build-time shader scripts import the vendored DSL by its real path,
    // and Node's own type stripping requires the extension to be written out.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
